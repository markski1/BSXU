# Generate each secret separately: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_KEY=
SECRET_KEY=
URL_PATH=https://files.example.com/
APP_HOST=127.0.0.1
APP_PORT=5000
PANEL_ENABLED=true
SESSION_COOKIE_SECURE=true
TRUST_PROXY_HEADERS=false

USE_B2_STORAGE=false
B2_KEY_ID=
B2_APP_KEY=
B2_BUCKET_NAME=

CACHE_FOLDER=/home/ubuntu/.bsxu-cache
STATE_FOLDER=/home/ubuntu/.bsxu-state
CACHE_MAX_SIZE_MB=2048
MAX_UPLOAD_SIZE_MB=128
STAGING_MAX_SIZE_MB=1032
MIN_FREE_DISK_MB=64
NAME_LENGTH=12

IMAGE_MAX_PIXELS=40000000
IMAGE_MAX_FRAMES=100
IMAGE_TIMEOUT_SECONDS=20

WEBHOOK_URL=false
WEBHOOK_PARAM=content
