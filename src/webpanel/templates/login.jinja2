{% extends "layout.jinja2" %}
{% block title %}Sign in{% endblock %}
{% block main %}
<section class="login-card">
    <h1>Sign in to BSXU</h1>
    <p class="muted">Use your admin key. Upload-only keys cannot open this panel.</p>
    {% if error %}<p class="notice error" role="alert">{{ error }}</p>{% endif %}
    <form action="{{ url_for('panel.login') }}" method="post" class="stack">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <label for="admin-key">Admin key</label>
        <input type="password" id="admin-key" name="auth_key" autocomplete="current-password" required maxlength="256" autofocus>
        <button type="submit">Sign in</button>
    </form>
</section>
{% endblock %}
