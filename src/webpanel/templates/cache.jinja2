{% extends "layout.jinja2" %}
{% block title %}Cached files{% endblock %}

{% block main %}

    <h3>Admin panel</h3>
    <p>Cached files</p>

    {% if cached_files %}
        <table style="width: 100%">
            <thead>
                <tr>
                    <td><b>Name</b></td>
                    <td><b>Size</b></td>
                    <td><b>Preview</b></td>
                </tr>
            </thead>
            <tbody>
                {% for file in cached_files %}
                    <tr>
                        <td>{{ file['name'] }}</td>
                        <td>{{ file['size'] }} Kb</td>
                        <td>
                            {% if file['is_image'] %}
                                <img src="{{ url_path }}thumbnail/{{ file['name'] }}" style="max-width: 192px; max-height: 192px" alt="Image preview for {{ file['name'] }}">
                            {% else %}
                                Cannot preview
                            {% endif %}
                        </td>
                        <td>
                            <form action="{{ url_for('panel.delete_cache_file', filename=file['name']) }}" method="POST" onsubmit="return confirm('Are you sure?')">
                                <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
                                <button type="submit">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>

    {% else %}
        <p>No files in the cache.</p>
    {% endif %}

    <p>Cache size: {{ total_size }} Kb</p>

    {% if not use_b2_storage %}
        <p style="color:red">Warning: B2 storage is disabled. The local cache is your only method of storage.</p>
    {% endif %}

    <form action="/panel/cache/clear" method="POST" onsubmit="return confirm('Are you sure?')">
        <input type="hidden" name="csrf_token" value="{{ csrf_token() }}">
        <input type="hidden" name="confirmation" value="standard">
        <button type="submit">Clear cache</button>
    </form>
    <a role="button" class="menu-button" href="/panel/main">Return</a>

{% endblock %}
