[Unit]
Description=BSXU file uploader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/uploader
EnvironmentFile=/home/ubuntu/uploader/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ubuntu/uploader/.venv/bin/gunicorn --bind 127.0.0.1:5000 --workers 2 --threads 2 --timeout 120 --graceful-timeout 30 --error-logfile - --log-level info app:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=40
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/.bsxu-cache /home/ubuntu/.bsxu-state
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=64
LimitNOFILE=4096

[Install]
WantedBy=multi-user.target
